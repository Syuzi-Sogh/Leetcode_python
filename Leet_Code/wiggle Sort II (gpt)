nums = [1,5,1,1,6,4]

nums.sort()

n = len(nums)
mid = (n - 1) // 2

left = nums[:mid+1]
right = nums[mid+1:]

left.reverse()
right.reverse()

res = []

for i in range(len(right)):
    res.append(left[i])
    res.append(right[i])

if len(left) > len(right):
    res.append(left[-1])

print(res)